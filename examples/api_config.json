{
  "schema_version": "1",
  "treatment": {
    "mode": "quantile",
    "source_column": "exposure_score",
    "quantile": 0.5,
    "treated_when": "ge"
  },
  "outcome": {
    "column": "recommendation",
    "levels": ["low", "middle", "high"],
    "scores": [1.0, 2.0, 3.0]
  },
  "segment": {
    "column": "expectation",
    "missing_values": []
  },
  "covariates": {
    "columns": ["age", "region"],
    "categorical_columns": ["region"]
  },
  "missing": {
    "strategy": "drop"
  }
}
